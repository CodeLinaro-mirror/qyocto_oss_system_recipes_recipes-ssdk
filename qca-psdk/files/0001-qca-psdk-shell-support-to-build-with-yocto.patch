From 8b045e7c55265ecb17778ac533e2117e4d60761e Mon Sep 17 00:00:00 2001
From: fpei <quic_fpei@quicinc.com>
Date: Fri, 1 Apr 2022 20:43:19 +0800
Subject: [PATCH] qca-psdk : Psdk shell support to build with yocto

Change-Id: I1118eb0cad3b1ec229bc5e61f27f374956bb0c9a
Signed-off-by: fpei <quic_fpei@quicinc.com>
---
 cli/Makefile | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)
 mode change 100644 => 100755 cli/Makefile

diff --git a/cli/Makefile b/cli/Makefile
old mode 100644
new mode 100755
index d9d0e9b..092f60f
--- a/cli/Makefile
+++ b/cli/Makefile
@@ -28,6 +28,7 @@ QCA808X_CLI_FLAGS = \
 		-DVERSION="\"$(VER)\""
 
 QCA808X_CLI_FLAGS += $(QCA808X_INCLUDES)
+QCA808X_CLI_FLAGS += $(CFLAGS)
 
 # cli part of makefile
 include $(SUBDIR)/target.mk
@@ -38,7 +39,7 @@ $(cli-objs):%.o : %.c
 	$(CC) $(QCA808X_CLI_FLAGS) -c -o $@ $<
 
 $(TARGET) : $(cli-objs)
-	$(CC) -o $(TARGET) -fPIC $^
+	$(CC) -o $(TARGET) -fPIC $^ $(LDFLAGS)
 
 install:
 	$(TOOL_PATH)/$(CROSS_COMPILE)strip $(TARGET)
-- 
2.17.1

